{
  "name": "clean-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "lint": "oxlint packages",
    "test": "vitest run",
    "start": "npm run build && node packages/infrastructure/dist/main.js"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
