{
  "name": "clean-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty && npm run typecheck -w @clean-chat/web",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo coverage",
    "lint": "oxlint packages",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "npm run build && node packages/infrastructure/dist/main.js",
    "dev": "npm run build && npm-run-all --parallel dev:server dev:frontend",
    "dev:types": "tsc -b --watch --preserveWatchOutput",
    "dev:server": "node packages/infrastructure/dist/main.js",
    "dev:frontend": "npm run dev -w @clean-chat/web"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.79.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
